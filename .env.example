# Server
NODE_ENV=development
PORT=8000

# MongoDB Atlas/local MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/blogify

# Must be at least 32 characters. Generate a random value for production.
JWT_SECRET=anything1234567892124@gg

# Local: http://localhost:5173 | Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000

# Required for production image uploads. Local development falls back to ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5
